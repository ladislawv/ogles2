; Run-M1 - ogles2 M7 run 3: EXT_clip_control. See ReadMe.txt.
;   CD to this directory, then:   Execute Run-M1
;   After a reboot in the middle:  Execute Run-M1 FROM=<step>
; Nothing is installed: libs/ is added to LIBS: for the run and removed at the
; end. Output goes to results/.
.key FROM/K
.def FROM 1
.bra {
.ket }

FailAt 21
If NOT EXISTS libs/ogles2.library
  Echo "Please CD into the ogles2-m7-3 directory first,"
  Echo "then run:  Execute Run-M1"
  Quit 20
EndIf

Assign M7R3: ""
If NOT EXISTS M7R3:results
  MakeDir M7R3:results
EndIf
Echo "ogles2 M7 run 3, starting at step {FROM}" >>M7R3:results/00-progress.txt
Date >>M7R3:results/00-progress.txt
Assign LIBS: M7R3:libs ADD
Avail FLUSH >NIL:
SetEnv OGLES2/LogFile M7R3:results/ogles2.log

If NOT {FROM} GT 1 VAL
  Echo "Step 1 of 2: triangles, depth, framebuffer objects as before (nothing to see)"
  M7R3:bin/m1_draw BITMAP QUICK >M7R3:results/1-draw.txt
  M7R3:bin/m4_depth >M7R3:results/1-depth.txt
  M7R3:bin/m5_fbo >M7R3:results/1-fbo.txt
  Echo "step 1 done" >>M7R3:results/00-progress.txt
EndIf

; m7_clip's program has no binary in bin/: the compiler in compiler/ compiles
; it into cache/, emptied first (a .v3dp there is used whatever compiler
; made it). The compiler is in LIBS: for this step only: step 1's tests
; would start it and count its memory. Last: it stays in memory a while.
If NOT {FROM} GT 2 VAL
  Echo "Step 2 of 2: clip control, the Z planes probe first (nothing to see)"
  If NOT EXISTS M7R3:cache
    MakeDir M7R3:cache
  EndIf
  Delete M7R3:cache/#? QUIET >NIL:
  Assign OGLES2Cache: M7R3:cache
  Assign LIBS: M7R3:compiler ADD
  M7R3:bin/m7_clip >M7R3:results/2-clip.txt
  Assign LIBS: M7R3:compiler REMOVE
  Assign OGLES2Cache:
  Echo "step 2 done" >>M7R3:results/00-progress.txt
EndIf

UnSetEnv OGLES2/LogFile
Assign LIBS: M7R3:libs REMOVE
Avail FLUSH >NIL:
If NOT EXISTS M7R3:results/notes.txt
  Copy M7R3:notes-template.txt M7R3:results/notes.txt
EndIf
List M7R3:results >M7R3:results/99-files.txt
Echo "finished" >>M7R3:results/00-progress.txt
Date >>M7R3:results/00-progress.txt
Assign M7R3:
Echo ""
Echo "Done. Results are in results/."

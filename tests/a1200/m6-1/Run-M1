; Run-M1 - ogles2 M6 run 1: gl4es, desktop OpenGL on ogles2. See ReadMe.txt.
;   CD to this directory, then:   Execute Run-M1
;   After a reboot in the middle:  Execute Run-M1 FROM=<step>
; Nothing is installed: libs/ is added to LIBS: for the run and removed at the
; end; OGLES2Cache: points at cache/ for the run. Output goes to results/.
.key FROM/K
.def FROM 1
.bra {
.ket }

FailAt 21
If NOT EXISTS libs/ogles2.library
  Echo "Please CD into the ogles2-m6-1 directory first,"
  Echo "then run:  Execute Run-M1"
  Quit 20
EndIf

Assign M6R1: ""
If NOT EXISTS M6R1:results
  MakeDir M6R1:results
EndIf
If NOT EXISTS M6R1:cache
  MakeDir M6R1:cache
EndIf
Echo "ogles2 M6 run 1, starting at step {FROM}" >>M6R1:results/00-progress.txt
Date >>M6R1:results/00-progress.txt
Assign LIBS: M6R1:libs ADD
Assign OGLES2Cache: M6R1:cache
Avail FLUSH >NIL:
SetEnv OGLES2/LogFile M6R1:results/ogles2.log

If NOT {FROM} GT 1 VAL
  Echo "Step 1 of 4: gl4es on a hidden bitmap, three ways of drawing (nothing"
  Echo "  to see). The first run compiles gl4es's shaders: up to a minute."
  M6R1:bin/gears_gl4es TEETH=1 PATH=IMMEDIATE >M6R1:results/1-bitmap.txt
  M6R1:bin/gears_gl4es TEETH=1 PATH=ARRAYS >>M6R1:results/1-bitmap.txt
  M6R1:bin/gears_gl4es TEETH=1 PATH=LIST >>M6R1:results/1-bitmap.txt
  Echo "step 1 done" >>M6R1:results/00-progress.txt
EndIf

If NOT {FROM} GT 2 VAL
  Echo "Step 2 of 4: the same with 8,000 triangles (nothing to see)"
  M6R1:bin/gears_gl4es TEETH=10 PATH=IMMEDIATE >M6R1:results/2-bitmap.txt
  M6R1:bin/gears_gl4es TEETH=10 PATH=ARRAYS >>M6R1:results/2-bitmap.txt
  M6R1:bin/gears_gl4es TEETH=10 PATH=LIST >>M6R1:results/2-bitmap.txt
  Echo "step 2 done" >>M6R1:results/00-progress.txt
EndIf

If NOT {FROM} GT 3 VAL
  Echo "Step 3 of 4: in a window, 5 seconds: three gears (red, green, blue)"
  Echo "  turning, the window titled gl4es; as the MiniGL and ogles2 ones."
  M6R1:bin/gears_gl4es WINDOW TEETH=1 PATH=LIST >M6R1:results/3-window.txt
  Echo "step 3 done" >>M6R1:results/00-progress.txt
EndIf

If NOT {FROM} GT 4 VAL
  Echo "Step 4 of 4: full screen, 5 seconds: the screen switches to the gears"
  Echo "  and back."
  M6R1:bin/gears_gl4es FULLSCREEN TEETH=1 PATH=LIST >M6R1:results/4-screen.txt
  Echo "step 4 done" >>M6R1:results/00-progress.txt
EndIf

UnSetEnv OGLES2/LogFile
Assign OGLES2Cache:
Assign LIBS: M6R1:libs REMOVE
If NOT EXISTS M6R1:results/notes.txt
  Copy M6R1:notes-template.txt M6R1:results/notes.txt
EndIf
List M6R1:cache >M6R1:results/98-cache.txt
List M6R1:results >M6R1:results/99-files.txt
Echo "finished" >>M6R1:results/00-progress.txt
Date >>M6R1:results/00-progress.txt
Assign M6R1:
Echo ""
Echo "Done. Results are in results/."

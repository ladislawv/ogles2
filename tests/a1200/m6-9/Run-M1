; Run-M1 - ogles2 M6 run 9: how the RTG screen presents. See ReadMe.txt.
;   CD to this directory, then:   Execute Run-M1
;   Some ways, longer:             Execute Run-M1 WAYS=34 SECONDS=10
;   Without the screen-only ways:  Execute Run-M1 WAYS=0
;   Without the GL ways (5-8):     Execute Run-M1 GL=0
; Nothing is installed: libs/ is added to LIBS: for the GL ways and removed at
; the end. Output goes to results/.
.key WAYS/K,SECONDS/K,PRI/K,GL/K
.def WAYS 1234
.def SECONDS 6
.def PRI 0
.def GL 1
.bra {
.ket }
FailAt 21
If NOT EXISTS bin/m6_flip
  Echo "Please CD into the ogles2-m6-9 directory first,"
  Echo "then run:  Execute Run-M1"
  Quit 20
EndIf

Assign M6R9: ""
If NOT EXISTS M6R9:results
  MakeDir M6R9:results
EndIf
Echo "ogles2 M6 run 9" >>M6R9:results/00-progress.txt
Date >>M6R9:results/00-progress.txt

If NOT "{WAYS}" EQ "0"
  Echo "A white bar crosses a 640x480 screen: ways {WAYS}, {SECONDS} seconds each."
  Echo "  The white squares at the top give the way's number (1 to 4)."
  Echo "  Watch for a broken (torn) bar and for jerky motion."
  M6R9:bin/m6_flip {WAYS} {SECONDS} {PRI} >M6R9:results/1-flip.txt
  Echo "flip done" >>M6R9:results/00-progress.txt
EndIf

If {GL} EQ 1 VAL
  Echo "The same bar drawn by ogles2.library, ways 5 to 8 (5 to 8 squares)."
  Assign LIBS: M6R9:libs ADD
  Avail FLUSH >NIL:
  SetEnv OGLES2/LogFile M6R9:results/ogles2.log
  CD M6R9:bin
  M6R9:bin/m6_vsync >M6R9:results/2-vsync.txt
  CD M6R9:
  UnSetEnv OGLES2/LogFile
  Assign LIBS: M6R9:libs REMOVE
  Avail FLUSH >NIL:
  Echo "vsync done" >>M6R9:results/00-progress.txt
EndIf

If NOT EXISTS M6R9:results/notes.txt
  Copy M6R9:notes-template.txt M6R9:results/notes.txt
EndIf
Echo "finished" >>M6R9:results/00-progress.txt
Date >>M6R9:results/00-progress.txt
Assign M6R9:
Echo ""
Echo "Done. Results are in results/."

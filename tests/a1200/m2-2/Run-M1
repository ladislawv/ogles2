; Run-M1 - ogles2 M2 run 2: textures. See ReadMe.txt.
;   CD to this directory, then:   Execute Run-M1
;   After a reboot in the middle:  Execute Run-M1 FROM=<step>
; Nothing is installed: libs/ is added to LIBS: for the run and removed at the
; end. Output goes to results/.
.key FROM/K
.def FROM 1
.bra {
.ket }

FailAt 21
If NOT EXISTS libs/ogles2.library
  Echo "Please CD into the ogles2-m2-2 directory first,"
  Echo "then run:  Execute Run-M1"
  Quit 20
EndIf

Assign M2R2: ""
If NOT EXISTS M2R2:results
  MakeDir M2R2:results
EndIf
Echo "ogles2 M2 run 2, starting at step {FROM}" >>M2R2:results/00-progress.txt
Date >>M2R2:results/00-progress.txt
Assign LIBS: M2R2:libs ADD
; Expunge libraries nobody has open: an ogles2.library left in memory by an
; earlier run would otherwise be used instead of this package's.
Avail FLUSH >NIL:
SetEnv OGLES2/LogFile M2R2:results/ogles2.log

If NOT {FROM} GT 1 VAL
  Echo "Step 1 of 3: linking programs from their binaries, uniforms (nothing to see)"
  M2R2:bin/m2_link >M2R2:results/1-link.txt
  Echo "step 1 done" >>M2R2:results/00-progress.txt
EndIf

If NOT {FROM} GT 2 VAL
  Echo "Step 2 of 3: textures, first on a hidden bitmap, then in a window titled ogles2,"
  Echo "  about 25 seconds, one picture a second: red/green/blue/white squares, stripes,"
  Echo "  single colours, a grey fade, coloured corners, orange, then red and green halves."
  Wait 3
  M2R2:bin/m2_texture >M2R2:results/2-texture.txt
  Echo "step 2 done" >>M2R2:results/00-progress.txt
EndIf

If NOT {FROM} GT 3 VAL
  Echo "Step 3 of 3: the triangle test again (about 15 seconds of quick flashes)."
  M2R2:bin/m1_draw QUICK >M2R2:results/3-draw.txt
  Echo "step 3 done" >>M2R2:results/00-progress.txt
EndIf

UnSetEnv OGLES2/LogFile
Assign LIBS: M2R2:libs REMOVE
If NOT EXISTS M2R2:results/notes.txt
  Copy M2R2:notes-template.txt M2R2:results/notes.txt
EndIf
List M2R2:results >M2R2:results/99-files.txt
Echo "finished" >>M2R2:results/00-progress.txt
Date >>M2R2:results/00-progress.txt
Assign M2R2:
Echo ""
Echo "Done. Results are in results/."

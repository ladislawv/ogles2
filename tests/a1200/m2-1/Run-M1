; Run-M1 - ogles2 M2 run 1: compiled GLSL programs. See ReadMe.txt.
;   CD to this directory, then:   Execute Run-M1
;   After a reboot in the middle:  Execute Run-M1 FROM=<step>
; Nothing is installed: libs/ is added to LIBS: for the run and removed at the
; end. Output goes to results/.
.key FROM/K
.def FROM 1
.bra {
.ket }

FailAt 21
If NOT EXISTS libs/ogles2.library
  Echo "Please CD into the ogles2-m2-1 directory first,"
  Echo "then run:  Execute Run-M1"
  Quit 20
EndIf

Assign M2R1: ""
If NOT EXISTS M2R1:results
  MakeDir M2R1:results
EndIf
Echo "ogles2 M2 run 1, starting at step {FROM}" >>M2R1:results/00-progress.txt
Date >>M2R1:results/00-progress.txt
Assign LIBS: M2R1:libs ADD
; Expunge libraries nobody has open: an ogles2.library left in memory by an
; earlier run would otherwise be used instead of this package's.
Avail FLUSH >NIL:
SetEnv OGLES2/LogFile M2R1:results/ogles2.log

If NOT {FROM} GT 1 VAL
  Echo "Step 1 of 3: linking programs from their binaries, uniforms (nothing to see)"
  M2R1:bin/m2_link >M2R1:results/1-link.txt
  Echo "step 1 done" >>M2R1:results/00-progress.txt
EndIf

If NOT {FROM} GT 2 VAL
  Echo "Step 2 of 3: the triangle test with the compiled program: hidden bitmap, a"
  Echo "  window, the whole screen (about 15 seconds of quick flashes)."
  Wait 3
  M2R1:bin/m1_draw QUICK >M2R1:results/2-draw.txt
  Echo "step 2 done" >>M2R1:results/00-progress.txt
EndIf

If NOT {FROM} GT 3 VAL
  Echo "Step 3 of 3: the soak with the compiled program, 10,000 frames in a window."
  M2R1:bin/m1_soak >M2R1:results/3-soak.txt
  Echo "step 3 done" >>M2R1:results/00-progress.txt
EndIf

UnSetEnv OGLES2/LogFile
Assign LIBS: M2R1:libs REMOVE
If NOT EXISTS M2R1:results/notes.txt
  Copy M2R1:notes-template.txt M2R1:results/notes.txt
EndIf
List M2R1:results >M2R1:results/99-files.txt
Echo "finished" >>M2R1:results/00-progress.txt
Date >>M2R1:results/00-progress.txt
Assign M2R1:
Echo ""
Echo "Done. Results are in results/."

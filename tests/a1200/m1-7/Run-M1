; Run-M1 - ogles2 M1 run 7: the first triangles. See ReadMe.txt.
;   CD to this directory, then:   Execute Run-M1
;   After a reboot in the middle:  Execute Run-M1 FROM=<step>
; Nothing is installed: libs/ is added to LIBS: for the run and removed at the
; end. Output goes to results/.
.key FROM/K
.def FROM 1
.bra {
.ket }

FailAt 21
If NOT EXISTS libs/ogles2.library
  Echo "Please CD into the ogles2-m1-7 directory first,"
  Echo "then run:  Execute Run-M1"
  Quit 20
EndIf

Assign M1R7: ""
If NOT EXISTS M1R7:results
  MakeDir M1R7:results
EndIf
Echo "ogles2 M1 run 7, starting at step {FROM}" >>M1R7:results/00-progress.txt
Date >>M1R7:results/00-progress.txt
Assign LIBS: M1R7:libs ADD
; Expunge libraries nobody has open: an ogles2.library left in memory by an
; earlier run would otherwise be used instead of this package's.
Avail FLUSH >NIL:
SetEnv OGLES2/LogFile M1R7:results/ogles2.log

If NOT {FROM} GT 1 VAL
  Echo "Step 1 of 4: step 1 again, clears on a hidden bitmap (nothing to see)"
  M1R7:bin/m1_clear BITMAP >M1R7:results/1-clear.txt
  Echo "step 1 done" >>M1R7:results/00-progress.txt
EndIf

If NOT {FROM} GT 2 VAL
  Echo "Step 2 of 4: triangles on a hidden bitmap (nothing to see, a few seconds)"
  M1R7:bin/m1_draw BITMAP >M1R7:results/2-bitmap.txt
  Echo "step 2 done" >>M1R7:results/00-progress.txt
EndIf

If NOT {FROM} GT 3 VAL
  Echo "Step 3 of 4: a window titled ogles2 opens, about 25 seconds. One picture a second:"
  Echo "  a triangle red/green/blue, yellow, small, then culling (on, off, on), blue"
  Echo "  over red, red, a half-width one, a white box, purple, cyan, green and"
  Echo "  magenta squares, a white line, a red box, cyan, dark green, red, a white"
  Echo "  triangle on grey, a white right half, then many small triangles flashing."
  Wait 3
  M1R7:bin/m1_draw WINDOW >M1R7:results/3-window.txt
  Echo "step 3 done" >>M1R7:results/00-progress.txt
EndIf

If NOT {FROM} GT 4 VAL
  Echo "Step 4 of 4: the whole screen, the same pictures, then the Workbench comes back."
  Wait 3
  M1R7:bin/m1_draw FULLSCREEN >M1R7:results/4-fullscreen.txt
  Echo "step 4 done" >>M1R7:results/00-progress.txt
EndIf

UnSetEnv OGLES2/LogFile
Assign LIBS: M1R7:libs REMOVE
If NOT EXISTS M1R7:results/notes.txt
  Copy M1R7:notes-template.txt M1R7:results/notes.txt
EndIf
List M1R7:results >M1R7:results/99-files.txt
Echo "finished" >>M1R7:results/00-progress.txt
Date >>M1R7:results/00-progress.txt
Assign M1R7:
Echo ""
Echo "Done. Results are in results/."

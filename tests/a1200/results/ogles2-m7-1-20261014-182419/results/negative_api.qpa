#beginTestCaseResult dEQP-GLES2.functional.negative_api.buffer.read_pixels
<?xml version="1.0" encoding="UTF-8"?>
<TestCaseResult CasePath="dEQP-GLES2.functional.negative_api.buffer.read_pixels" Version="0.3.4" CaseType="SelfValidate">
 <Section Name="" Description="GL_INVALID_OPERATION is generated if the combination of format and type is unsupported.">
  <Text>glReadPixels(0, 0, 1, 1, GL_LUMINANCE_ALPHA, GL_UNSIGNED_SHORT_4_4_4_4, 0xa777fa4);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_OPERATION returned</Text>
</Section>
 <Section Name="" Description="GL_INVALID_VALUE is generated if either width or height is negative.">
  <Text>glReadPixels(0, 0, -1, 1, GL_RGBA, GL_UNSIGNED_BYTE, 0xa777fa4);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_VALUE returned</Text>
  <Text>glReadPixels(0, 0, 1, -1, GL_RGBA, GL_UNSIGNED_BYTE, 0xa777fa4);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_VALUE returned</Text>
  <Text>glReadPixels(0, 0, -1, -1, GL_RGBA, GL_UNSIGNED_BYTE, 0xa777fa4);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_VALUE returned</Text>
</Section>
 <Section Name="" Description="GL_INVALID_FRAMEBUFFER_OPERATION is generated if the currently bound framebuffer is not framebuffer complete.">
  <Text>glGenFramebuffers(1, 0x0a6df7d0);</Text>
  <Text>// framebuffers = { 1 }</Text>
  <Text>glBindFramebuffer(GL_FRAMEBUFFER, 1);</Text>
  <Text>glCheckFramebufferStatus(GL_FRAMEBUFFER);</Text>
  <Text>// GL_FRAMEBUFFER_INCOMPLETE_MISSING_ATTACHMENT returned</Text>
  <Text>glReadPixels(0, 0, 1, 1, GL_RGBA, GL_UNSIGNED_BYTE, 0xa777fa4);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_FRAMEBUFFER_OPERATION returned</Text>
</Section>
 <Number Name="TestDuration" Description="Test case duration in microseconds" Tag="Time" Unit="us">10601</Number>
 <Result StatusCode="Pass">Pass</Result>
</TestCaseResult>

#endTestCaseResult

#beginTestCaseResult dEQP-GLES2.functional.negative_api.buffer.read_pixels_format_mismatch
<?xml version="1.0" encoding="UTF-8"?>
<TestCaseResult CasePath="dEQP-GLES2.functional.negative_api.buffer.read_pixels_format_mismatch" Version="0.3.4" CaseType="SelfValidate">
 <Section Name="" Description="Unsupported combinations of format and type will generate an INVALID_OPERATION error.">
  <Text>glReadPixels(0, 0, 1, 1, GL_RGBA, GL_UNSIGNED_SHORT_5_6_5, 0xa778f64);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_OPERATION returned</Text>
  <Text>glReadPixels(0, 0, 1, 1, GL_ALPHA, GL_UNSIGNED_SHORT_5_6_5, 0xa778f64);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_OPERATION returned</Text>
  <Text>glReadPixels(0, 0, 1, 1, GL_RGB, GL_UNSIGNED_SHORT_4_4_4_4, 0xa778f64);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_OPERATION returned</Text>
  <Text>glReadPixels(0, 0, 1, 1, GL_ALPHA, GL_UNSIGNED_SHORT_4_4_4_4, 0xa778f64);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_OPERATION returned</Text>
  <Text>glReadPixels(0, 0, 1, 1, GL_RGB, GL_UNSIGNED_SHORT_5_5_5_1, 0xa778f64);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_OPERATION returned</Text>
  <Text>glReadPixels(0, 0, 1, 1, GL_ALPHA, GL_UNSIGNED_SHORT_5_5_5_1, 0xa778f64);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_OPERATION returned</Text>
</Section>
 <Section Name="" Description="GL_RGBA/GL_UNSIGNED_BYTE is always accepted and the other acceptable pair can be discovered by querying GL_IMPLEMENTATION_COLOR_READ_FORMAT and GL_IMPLEMENTATION_COLOR_READ_TYPE.">
  <Text>glReadPixels(0, 0, 1, 1, GL_RGBA, GL_UNSIGNED_BYTE, 0xa777fa4);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_NO_ERROR returned</Text>
  <Text>glGetIntegerv(GL_IMPLEMENTATION_COLOR_READ_FORMAT, 0x0a6df7b8);</Text>
  <Text>// data = { 6408 }</Text>
  <Text>glGetIntegerv(GL_IMPLEMENTATION_COLOR_READ_TYPE, 0x0a6df7d0);</Text>
  <Text>// data = { 5121 }</Text>
  <Text>glReadPixels(0, 0, 1, 1, GL_RGBA, GL_UNSIGNED_BYTE, 0xa777fa4);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_NO_ERROR returned</Text>
</Section>
 <Number Name="TestDuration" Description="Test case duration in microseconds" Tag="Time" Unit="us">7116</Number>
 <Result StatusCode="Pass">Pass</Result>
</TestCaseResult>

#endTestCaseResult


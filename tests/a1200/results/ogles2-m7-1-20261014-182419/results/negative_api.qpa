#beginTestCaseResult dEQP-GLES2.functional.negative_api.buffer.buffer_data
<?xml version="1.0" encoding="UTF-8"?>
<TestCaseResult CasePath="dEQP-GLES2.functional.negative_api.buffer.buffer_data" Version="0.3.4" CaseType="SelfValidate">
 <Text>glGenBuffers(1, 0x0a6df798);</Text>
 <Text>// buffers = { 1 }</Text>
 <Text>glBindBuffer(GL_ARRAY_BUFFER, 1);</Text>
 <Section Name="" Description="GL_INVALID_ENUM is generated if target is not GL_ARRAY_BUFFER or GL_ELEMENT_ARRAY_BUFFER.">
  <Text>glBufferData(0xffffffffffffffff, 0, 0, GL_STREAM_DRAW);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_ENUM returned</Text>
</Section>
 <Section Name="" Description="GL_INVALID_ENUM is generated if usage is not GL_STREAM_DRAW, GL_STATIC_DRAW, or GL_DYNAMIC_DRAW.">
  <Text>glBufferData(GL_ARRAY_BUFFER, 0, 0, 0xffffffffffffffff);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_ENUM returned</Text>
</Section>
 <Section Name="" Description="GL_INVALID_VALUE is generated if size is negative.">
  <Text>glBufferData(GL_ARRAY_BUFFER, -1, 0, GL_STREAM_DRAW);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_VALUE returned</Text>
</Section>
 <Section Name="" Description="GL_INVALID_OPERATION is generated if the reserved buffer object name 0 is bound to target.">
  <Text>glBindBuffer(GL_ARRAY_BUFFER, 0);</Text>
  <Text>glBufferData(GL_ARRAY_BUFFER, 0, 0, GL_STREAM_DRAW);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_OPERATION returned</Text>
</Section>
 <Text>glDeleteBuffers(1, { 1 });</Text>
 <Number Name="TestDuration" Description="Test case duration in microseconds" Tag="Time" Unit="us">6396</Number>
 <Result StatusCode="Pass">Pass</Result>
</TestCaseResult>

#endTestCaseResult


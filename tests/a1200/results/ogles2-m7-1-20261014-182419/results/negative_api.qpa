#beginTestCaseResult dEQP-GLES2.functional.negative_api.buffer.framebuffer_renderbuffer
<?xml version="1.0" encoding="UTF-8"?>
<TestCaseResult CasePath="dEQP-GLES2.functional.negative_api.buffer.framebuffer_renderbuffer" Version="0.3.4" CaseType="SelfValidate">
 <Text>glGenFramebuffers(1, 0x0a6df794);</Text>
 <Text>// framebuffers = { 2 }</Text>
 <Text>glBindFramebuffer(GL_FRAMEBUFFER, 2);</Text>
 <Text>glGenRenderbuffers(1, 0x0a6df798);</Text>
 <Text>// renderbuffers = { 1 }</Text>
 <Section Name="" Description="GL_INVALID_ENUM is generated if target is not GL_FRAMEBUFFER.">
  <Text>glFramebufferRenderbuffer(0xffffffffffffffff, GL_COLOR_ATTACHMENT0, GL_RENDERBUFFER, 0);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_ENUM returned</Text>
</Section>
 <Section Name="" Description="GL_INVALID_ENUM is generated if attachment is not an accepted attachment point.">
  <Text>glFramebufferRenderbuffer(GL_FRAMEBUFFER, 0xffffffffffffffff, GL_RENDERBUFFER, 0);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_ENUM returned</Text>
</Section>
 <Section Name="" Description="GL_INVALID_ENUM is generated if renderbuffertarget is not GL_RENDERBUFFER.">
  <Text>glBindRenderbuffer(GL_RENDERBUFFER, 1);</Text>
  <Text>glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, 0xffffffffffffffff, 1);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_ENUM returned</Text>
  <Text>glBindRenderbuffer(GL_RENDERBUFFER, 0);</Text>
</Section>
 <Section Name="" Description="GL_INVALID_OPERATION is generated if renderbuffer is neither 0 nor the name of an existing renderbuffer object.">
  <Text>glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_RENDERBUFFER, 4294967295);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_OPERATION returned</Text>
</Section>
 <Section Name="" Description="GL_INVALID_OPERATION is generated if the default framebuffer object name 0 is bound.">
  <Text>glBindFramebuffer(GL_FRAMEBUFFER, 0);</Text>
  <Text>glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_RENDERBUFFER, 0);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_OPERATION returned</Text>
</Section>
 <Text>glDeleteRenderbuffers(1, { 1 });</Text>
 <Text>glDeleteFramebuffers(1, { 2 });</Text>
 <Number Name="TestDuration" Description="Test case duration in microseconds" Tag="Time" Unit="us">7975</Number>
 <Result StatusCode="Pass">Pass</Result>
</TestCaseResult>

#endTestCaseResult

#beginTestCaseResult dEQP-GLES2.functional.negative_api.buffer.framebuffer_texture2d
<?xml version="1.0" encoding="UTF-8"?>
<TestCaseResult CasePath="dEQP-GLES2.functional.negative_api.buffer.framebuffer_texture2d" Version="0.3.4" CaseType="SelfValidate">
 <Text>glGenFramebuffers(1, 0x0a6df790);</Text>
 <Text>// framebuffers = { 2 }</Text>
 <Text>glBindFramebuffer(GL_FRAMEBUFFER, 2);</Text>
 <Text>glGenTextures(1, 0x0a6df794);</Text>
 <Text>// textures = { 1 }</Text>
 <Text>glBindTexture(GL_TEXTURE_2D, 1);</Text>
 <Text>glGenTextures(1, 0x0a6df798);</Text>
 <Text>// textures = { 2 }</Text>
 <Text>glBindTexture(GL_TEXTURE_CUBE_MAP, 2);</Text>
 <Text>glGetError();</Text>
 <Text>// GL_NO_ERROR returned</Text>
 <Section Name="" Description="GL_INVALID_ENUM is generated if target is not GL_FRAMEBUFFER.">
  <Text>glFramebufferTexture2D(0xffffffffffffffff, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, 0, 0);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_ENUM returned</Text>
</Section>
 <Section Name="" Description="GL_INVALID_ENUM is generated if textarget is not an accepted texture target.">
  <Text>glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, 0xffffffffffffffff, 1, 0);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_ENUM returned</Text>
</Section>
 <Section Name="" Description="GL_INVALID_ENUM is generated if attachment is not an accepted attachment point.">
  <Text>glFramebufferTexture2D(GL_FRAMEBUFFER, 0xffffffffffffffff, GL_TEXTURE_2D, 0, 0);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_ENUM returned</Text>
</Section>
 <Section Name="" Description="GL_INVALID_OPERATION is generated if texture is neither 0 nor the name of an existing texture object.">
  <Text>glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, 4294967295, 0);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_OPERATION returned</Text>
</Section>
 <Section Name="" Description="GL_INVALID_OPERATION is generated if texture is the name of an existing two-dimensional texture object but textarget is not GL_TEXTURE_2D.">
  <Text>glGetError();</Text>
  <Text>// GL_NO_ERROR returned</Text>
  <Text>glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_CUBE_MAP_POSITIVE_X, 1, 0);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_OPERATION returned</Text>
  <Text>glDeleteTextures(1, { 1 });</Text>
</Section>
 <Section Name="" Description="GL_INVALID_OPERATION is generated if texture is the name of an existing cube map texture object but textarget is GL_TEXTURE_2D.">
  <Text>glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, 2, 0);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_OPERATION returned</Text>
  <Text>glDeleteTextures(1, { 2 });</Text>
</Section>
 <Section Name="" Description="GL_INVALID_OPERATION is generated if the default framebuffer object name 0 is bound.">
  <Text>glBindFramebuffer(GL_FRAMEBUFFER, 0);</Text>
  <Text>glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, 0, 0);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_OPERATION returned</Text>
</Section>
 <Text>glDeleteFramebuffers(1, { 2 });</Text>
 <Number Name="TestDuration" Description="Test case duration in microseconds" Tag="Time" Unit="us">13098</Number>
 <Result StatusCode="Pass">Pass</Result>
</TestCaseResult>

#endTestCaseResult

#beginTestCaseResult dEQP-GLES2.functional.negative_api.buffer.renderbuffer_storage
<?xml version="1.0" encoding="UTF-8"?>
<TestCaseResult CasePath="dEQP-GLES2.functional.negative_api.buffer.renderbuffer_storage" Version="0.3.4" CaseType="SelfValidate">
 <Text>glGenRenderbuffers(1, 0x0a6df794);</Text>
 <Text>// renderbuffers = { 1 }</Text>
 <Text>glBindRenderbuffer(GL_RENDERBUFFER, 1);</Text>
 <Section Name="" Description="GL_INVALID_ENUM is generated if target is not GL_RENDERBUFFER.">
  <Text>glRenderbufferStorage(0xffffffffffffffff, GL_RGBA4, 1, 1);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_ENUM returned</Text>
  <Text>glRenderbufferStorage(GL_FRAMEBUFFER, GL_RGBA4, 1, 1);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_ENUM returned</Text>
</Section>
 <Section Name="" Description="GL_INVALID_ENUM is generated if internalformat is not an accepted format.">
  <Text>glRenderbufferStorage(GL_RENDERBUFFER, 0xffffffffffffffff, 1, 1);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_ENUM returned</Text>
  <Text>glRenderbufferStorage(GL_RENDERBUFFER, GL_RGBA, 1, 1);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_ENUM returned</Text>
  <Text>glRenderbufferStorage(GL_RENDERBUFFER, GL_DEPTH_COMPONENT, 1, 1);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_ENUM returned</Text>
</Section>
 <Section Name="" Description="GL_INVALID_VALUE is generated if width or height is less than zero.">
  <Text>glRenderbufferStorage(GL_RENDERBUFFER, GL_RGBA4, -1, 1);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_VALUE returned</Text>
  <Text>glRenderbufferStorage(GL_RENDERBUFFER, GL_RGBA4, 1, -1);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_VALUE returned</Text>
  <Text>glRenderbufferStorage(GL_RENDERBUFFER, GL_RGBA4, -1, -1);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_VALUE returned</Text>
</Section>
 <Section Name="" Description="GL_INVALID_VALUE is generated if width or height is greater than GL_MAX_RENDERBUFFER_SIZE.">
  <Text>glGetIntegerv(GL_MAX_RENDERBUFFER_SIZE, 0x0a6df798);</Text>
  <Text>// data = { 4096 }</Text>
  <Text>glRenderbufferStorage(GL_RENDERBUFFER, GL_RGBA4, 1, 4097);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_VALUE returned</Text>
  <Text>glRenderbufferStorage(GL_RENDERBUFFER, GL_RGBA4, 4097, 1);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_VALUE returned</Text>
  <Text>glRenderbufferStorage(GL_RENDERBUFFER, GL_RGBA4, 4097, 4097);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_VALUE returned</Text>
</Section>
 <Section Name="" Description="GL_INVALID_OPERATION is generated if the reserved renderbuffer object name 0 is bound.">
  <Text>glBindRenderbuffer(GL_RENDERBUFFER, 0);</Text>
  <Text>glRenderbufferStorage(GL_RENDERBUFFER, GL_RGBA4, 1, 1);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_OPERATION returned</Text>
</Section>
 <Text>glDeleteRenderbuffers(1, { 1 });</Text>
 <Number Name="TestDuration" Description="Test case duration in microseconds" Tag="Time" Unit="us">15026</Number>
 <Result StatusCode="Pass">Pass</Result>
</TestCaseResult>

#endTestCaseResult


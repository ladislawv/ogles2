  <Text>// params = { 0 }</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_OPERATION returned</Text>
</Section>
 <Text>glDeleteShader(1);</Text>
 <Text>glDeleteProgram(2);</Text>

#beginTestCaseResult dEQP-GLES2.functional.negative_api.vertex_array.vertex_attrib
<?xml version="1.0" encoding="UTF-8"?>
<TestCaseResult CasePath="dEQP-GLES2.functional.negative_api.vertex_array.vertex_attrib" Version="0.3.4" CaseType="SelfValidate">
 <Section Name="" Description="GL_INVALID_VALUE is generated if index is greater than or equal to GL_MAX_VERTEX_ATTRIBS.">
  <Text>glVertexAttrib1f(16, 0);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_VALUE returned</Text>
  <Text>glVertexAttrib2f(16, 0, 0);</Text>
  <Text>glGetError();</Text>

<TestCaseResult CasePath="dEQP-GLES2.functional.negative_api.texture.bindtexture_type_mismatch" Version="0.3.4" CaseType="SelfValidate">
 <Section Name="" Description="GL_INVALID_OPERATION is generated if texture was previously created with a target that doesn&apos;t match that of target.">
  <Text>glGenTextures(1, 0x0a6df7d0);</Text>
  <Text>// textures = { 1 }</Text>
  <Text>glBindTexture(GL_TEXTURE_2D, 1);</Text>
  <Text>glBindTexture(GL_TEXTURE_CUBE_MAP, 1);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_OPERATION returned</Text>
  <Text>glDeleteTextures(1, { 1 });</Text>
</Section>
 <Number Name="TestDuration" Description="Test case duration in microseconds" Tag="Time" Unit="us">5548</Number>
 <Result StatusCode="Pass">Pass</Result>
</TestCaseResult>

#endTestCaseResult


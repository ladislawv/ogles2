#beginTestCaseResult dEQP-GLES2.functional.negative_api.state.get_framebuffer_attachment_parameteriv
<?xml version="1.0" encoding="UTF-8"?>
<TestCaseResult CasePath="dEQP-GLES2.functional.negative_api.state.get_framebuffer_attachment_parameteriv" Version="0.3.4" CaseType="SelfValidate">
 <Text>glGetIntegerv(GL_MAJOR_VERSION, 0x0a6df794);</Text>
 <Text>// data = { 0 }</Text>
 <Text>glGetError();</Text>
 <Text>// GL_INVALID_ENUM returned</Text>
 <Text>glGenFramebuffers(1, 0x0a6df79c);</Text>
 <Text>// framebuffers = { 2 }</Text>
 <Text>glBindFramebuffer(GL_FRAMEBUFFER, 2);</Text>
 <Section Name="" Description="GL_INVALID_ENUM is generated if target is not GL_FRAMEBUFFER.">
  <Text>glGetFramebufferAttachmentParameteriv(0xffffffffffffffff, GL_COLOR_ATTACHMENT0, GL_FRAMEBUFFER_ATTACHMENT_OBJECT_TYPE, 0x0a6df798);</Text>
  <Text>// params = 0xffffffffffffffff</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_ENUM returned</Text>
</Section>
 <Section Name="" Description="GL_INVALID_ENUM is generated if there is no attached object at the named attachment point and pname is not GL_FRAMEBUFFER_ATTACHMENT_OBJECT_TYPE.">
  <Text>glGetFramebufferAttachmentParameteriv(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_FRAMEBUFFER_ATTACHMENT_OBJECT_NAME, 0x0a6df798);</Text>
  <Text>// params = -1</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_ENUM returned</Text>
</Section>
 <Section Name="" Description="GL_INVALID_ENUM is generated if the attached object at the named attachment point is incompatible with pname.">
  <Text>glGetFramebufferAttachmentParameteriv(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_FRAMEBUFFER_ATTACHMENT_OBJECT_TYPE, 0x0a6df7d0);</Text>
  <Text>// params = GL_NONE</Text>
  <Text>glGetError();</Text>
  <Text>// GL_NO_ERROR returned</Text>
  <Text>glGetFramebufferAttachmentParameteriv(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_FRAMEBUFFER_ATTACHMENT_OBJECT_NAME, 0x0a6df798);</Text>
  <Text>// params = -1</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_ENUM returned</Text>
</Section>
 <Section Name="" Description="GL_INVALID_OPERATION is generated if the default framebuffer object name 0 is bound.">
  <Text>glBindFramebuffer(GL_FRAMEBUFFER, 0);</Text>
  <Text>glGetFramebufferAttachmentParameteriv(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_FRAMEBUFFER_ATTACHMENT_OBJECT_TYPE, 0x0a6df798);</Text>
  <Text>// params = 0xffffffffffffffff</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_OPERATION returned</Text>
</Section>
 <Text>glDeleteFramebuffers(1, { 2 });</Text>
 <Number Name="TestDuration" Description="Test case duration in microseconds" Tag="Time" Unit="us">12513</Number>
 <Result StatusCode="Pass">Pass</Result>
</TestCaseResult>


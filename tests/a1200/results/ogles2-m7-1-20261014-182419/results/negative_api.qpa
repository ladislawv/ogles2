 <Text>glGetError();</Text>
 <Text>// GL_NO_ERROR returned</Text>
 <Text>glGetIntegerv(GL_COMPRESSED_TEXTURE_FORMATS, 0x0a77c0b4);</Text>
 <Text>// data = { 36196 }</Text>
 <Text>glGetError();</Text>
 <Text>// GL_NO_ERROR returned</Text>
 <Section Name="" Description="GL_INVALID_VALUE is generated if imageSize is not consistent with the format, dimensions, and contents of the specified compressed image data.">
  <Text>glCompressedTexImage2D(GL_TEXTURE_2D, 0, 0x8d64, 0, 0, 0, ffffffff, 0);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_VALUE returned</Text>
</Section>
 <Number Name="TestDuration" Description="Test case duration in microseconds" Tag="Time" Unit="us">3435</Number>
 <Result StatusCode="Pass">Pass</Result>
</TestCaseResult>

#endTestCaseResult


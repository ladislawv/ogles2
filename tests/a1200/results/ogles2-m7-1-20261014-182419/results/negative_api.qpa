#beginTestCaseResult dEQP-GLES2.functional.negative_api.buffer.buffer_sub_data_size_offset
<?xml version="1.0" encoding="UTF-8"?>
<TestCaseResult CasePath="dEQP-GLES2.functional.negative_api.buffer.buffer_sub_data_size_offset" Version="0.3.4" CaseType="SelfValidate">
 <Text>glGenBuffers(1, 0x0a6df798);</Text>
 <Text>// buffers = { 1 }</Text>
 <Text>glBindBuffer(GL_ARRAY_BUFFER, 1);</Text>
 <Text>glBufferData(GL_ARRAY_BUFFER, 10, 0, GL_STREAM_DRAW);</Text>
 <Section Name="" Description="GL_INVALID_VALUE is generated if offset or size is negative, or if together they define a region of memory that extends beyond the buffer object&apos;s allocated data store.">
  <Text>glBufferSubData(GL_ARRAY_BUFFER, -1, 1, 0);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_VALUE returned</Text>
  <Text>glBufferSubData(GL_ARRAY_BUFFER, -1, -1, 0);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_VALUE returned</Text>
  <Text>glBufferSubData(GL_ARRAY_BUFFER, 1, -1, 0);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_VALUE returned</Text>
  <Text>glBufferSubData(GL_ARRAY_BUFFER, 15, 1, 0);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_VALUE returned</Text>
  <Text>glBufferSubData(GL_ARRAY_BUFFER, 1, 15, 0);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_VALUE returned</Text>
  <Text>glBufferSubData(GL_ARRAY_BUFFER, 8, 8, 0);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_VALUE returned</Text>
</Section>
 <Text>glDeleteBuffers(1, { 1 });</Text>
 <Number Name="TestDuration" Description="Test case duration in microseconds" Tag="Time" Unit="us">6746</Number>
 <Result StatusCode="Pass">Pass</Result>
</TestCaseResult>

#endTestCaseResult


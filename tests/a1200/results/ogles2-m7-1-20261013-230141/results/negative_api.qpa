#beginTestCaseResult dEQP-GLES2.functional.negative_api.shader.attach_shader
<?xml version="1.0" encoding="UTF-8"?>
<TestCaseResult CasePath="dEQP-GLES2.functional.negative_api.shader.attach_shader" Version="0.3.4" CaseType="SelfValidate">
 <Text>glCreateShader(GL_VERTEX_SHADER);</Text>
 <Text>// 1 returned</Text>
 <Text>glCreateShader(GL_VERTEX_SHADER);</Text>
 <Text>// 2 returned</Text>
 <Text>glCreateProgram();</Text>
 <Text>// 3 returned</Text>
 <Section Name="" Description="GL_INVALID_OPERATION is generated if program is not a program object.">
  <Text>glAttachShader(1, 1);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_OPERATION returned</Text>
</Section>
 <Section Name="" Description="GL_INVALID_OPERATION is generated if shader is not a shader object.">
  <Text>glAttachShader(3, 3);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_OPERATION returned</Text>
  <Text>glAttachShader(1, 3);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_OPERATION returned</Text>
</Section>
 <Section Name="" Description="GL_INVALID_VALUE is generated if either program or shader is not a value generated by OpenGL.">
  <Text>glAttachShader(3, 4294967295);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_VALUE returned</Text>
  <Text>glAttachShader(4294967295, 1);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_VALUE returned</Text>
  <Text>glAttachShader(4294967295, 4294967295);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_VALUE returned</Text>
</Section>
 <Section Name="" Description="GL_INVALID_OPERATION is generated if shader is already attached to program, or if another shader object of the same type as shader is already attached to program.">
  <Text>glAttachShader(3, 1);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_NO_ERROR returned</Text>
  <Text>glAttachShader(3, 1);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_OPERATION returned</Text>
  <Text>glAttachShader(3, 2);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_OPERATION returned</Text>
</Section>
 <Text>glDeleteProgram(3);</Text>
 <Text>glDeleteShader(1);</Text>
 <Text>glDeleteShader(2);</Text>
 <Number Name="TestDuration" Description="Test case duration in microseconds" Tag="Time" Unit="us">8486</Number>
 <Result StatusCode="Pass">Pass</Result>
</TestCaseResult>

#endTestCaseResult


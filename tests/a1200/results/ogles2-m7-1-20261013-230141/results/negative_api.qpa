#beginTestCaseResult dEQP-GLES2.functional.negative_api.texture.copytexsubimage2d_incomplete_framebuffer
<?xml version="1.0" encoding="UTF-8"?>
<TestCaseResult CasePath="dEQP-GLES2.functional.negative_api.texture.copytexsubimage2d_incomplete_framebuffer" Version="0.3.4" CaseType="SelfValidate">
 <Section Name="" Description="GL_INVALID_FRAMEBUFFER_OPERATION is generated if the currently bound framebuffer is not framebuffer complete.">
  <Text>glGenTextures(2, 0x0b00fc90);</Text>
  <Text>// textures = { 1, 2 }</Text>
  <Text>glBindTexture(GL_TEXTURE_2D, 1);</Text>
  <Text>glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, 4, 4, 0, GL_RGBA, GL_UNSIGNED_BYTE, 0);</Text>
  <Text>glBindTexture(GL_TEXTURE_CUBE_MAP, 2);</Text>
  <Text>glTexImage2D(GL_TEXTURE_CUBE_MAP_POSITIVE_X, 0, GL_RGBA, 4, 4, 0, GL_RGBA, GL_UNSIGNED_BYTE, 0);</Text>
  <Text>glTexImage2D(GL_TEXTURE_CUBE_MAP_POSITIVE_Y, 0, GL_RGBA, 4, 4, 0, GL_RGBA, GL_UNSIGNED_BYTE, 0);</Text>
  <Text>glTexImage2D(GL_TEXTURE_CUBE_MAP_POSITIVE_Z, 0, GL_RGBA, 4, 4, 0, GL_RGBA, GL_UNSIGNED_BYTE, 0);</Text>
  <Text>glTexImage2D(GL_TEXTURE_CUBE_MAP_NEGATIVE_X, 0, GL_RGBA, 4, 4, 0, GL_RGBA, GL_UNSIGNED_BYTE, 0);</Text>
  <Text>glTexImage2D(GL_TEXTURE_CUBE_MAP_NEGATIVE_Y, 0, GL_RGBA, 4, 4, 0, GL_RGBA, GL_UNSIGNED_BYTE, 0);</Text>
  <Text>glTexImage2D(GL_TEXTURE_CUBE_MAP_NEGATIVE_Z, 0, GL_RGBA, 4, 4, 0, GL_RGBA, GL_UNSIGNED_BYTE, 0);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_NO_ERROR returned</Text>
  <Text>glGenFramebuffers(1, 0x0b00fc78);</Text>
  <Text>// framebuffers = { 2 }</Text>
  <Text>glBindFramebuffer(GL_FRAMEBUFFER, 2);</Text>
  <Text>glCheckFramebufferStatus(GL_FRAMEBUFFER);</Text>
  <Text>// GL_FRAMEBUFFER_INCOMPLETE_MISSING_ATTACHMENT returned</Text>
  <Text>glGetError();</Text>
  <Text>// GL_NO_ERROR returned</Text>
  <Text>glCopyTexSubImage2D(0x00000de1, 0, 0, 0, 0, 0, 0, 0);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_FRAMEBUFFER_OPERATION returned</Text>
  <Text>glCopyTexSubImage2D(0x00008515, 0, 0, 0, 0, 0, 0, 0);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_FRAMEBUFFER_OPERATION returned</Text>
  <Text>glCopyTexSubImage2D(0x00008517, 0, 0, 0, 0, 0, 0, 0);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_FRAMEBUFFER_OPERATION returned</Text>
  <Text>glCopyTexSubImage2D(0x00008519, 0, 0, 0, 0, 0, 0, 0);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_FRAMEBUFFER_OPERATION returned</Text>
  <Text>glCopyTexSubImage2D(0x00008516, 0, 0, 0, 0, 0, 0, 0);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_FRAMEBUFFER_OPERATION returned</Text>
  <Text>glCopyTexSubImage2D(0x00008518, 0, 0, 0, 0, 0, 0, 0);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_FRAMEBUFFER_OPERATION returned</Text>
  <Text>glCopyTexSubImage2D(0x0000851a, 0, 0, 0, 0, 0, 0, 0);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_FRAMEBUFFER_OPERATION returned</Text>
  <Text>glBindFramebuffer(GL_FRAMEBUFFER, 0);</Text>
  <Text>glDeleteFramebuffers(1, { 2 });</Text>
  <Text>glDeleteTextures(2, { 1, 2 });</Text>
</Section>
 <Number Name="TestDuration" Description="Test case duration in microseconds" Tag="Time" Unit="us">10985</Number>
 <Result StatusCode="Pass">Pass</Result>
</TestCaseResult>

#endTestCaseResult


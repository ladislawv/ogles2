 <Text>// 0 returned</Text>
 <Text>glGetUniformLocation(1, fTest);</Text>
 <Text>// 1 returned</Text>
 <Text>glCreateShader(GL_VERTEX_SHADER);</Text>
 <Text>// 4 returned</Text>
 <Text>glCreateProgram();</Text>
 <Text>// 5 returned</Text>
 <Section Name="" Description="GL_INVALID_VALUE is generated if program is not a value generated by OpenGL.">
  <Text>glGetUniformfv(4294967295, 0, 0x0b00fae8);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_VALUE returned</Text>
</Section>
 <Section Name="" Description="GL_INVALID_OPERATION is generated if program is not a program object.">
  <Text>glGetUniformfv(4, 0, 0x0b00fae8);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_OPERATION returned</Text>
</Section>
 <Section Name="" Description="GL_INVALID_OPERATION is generated if program has not been successfully linked.">
  <Text>glGetUniformfv(5, 0, 0x0b00fae8);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_OPERATION returned</Text>
</Section>
 <Section Name="" Description="GL_INVALID_OPERATION is generated if location does not correspond to a valid uniform variable location for the specified program object.">
  <Text>glGetUniformfv(1, 2, 0x0b00fae8);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_OPERATION returned</Text>
</Section>
 <Text>glDeleteShader(4);</Text>
 <Text>glDeleteProgram(5);</Text>
 <Number Name="TestDuration" Description="Test case duration in microseconds" Tag="Time" Unit="us">18701</Number>
 <Result StatusCode="Pass">Pass</Result>
</TestCaseResult>

#endTestCaseResult


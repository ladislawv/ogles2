#beginTestCaseResult dEQP-GLES2.functional.negative_api.buffer.bind_buffer
<?xml version="1.0" encoding="UTF-8"?>
<TestCaseResult CasePath="dEQP-GLES2.functional.negative_api.buffer.bind_buffer" Version="0.3.4" CaseType="SelfValidate">
 <Section Name="" Description="GL_INVALID_ENUM is generated if target is not one of the allowable values.">

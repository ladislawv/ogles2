<TestCaseResult CasePath="dEQP-GLES2.functional.negative_api.shader.shader_source" Version="0.3.4" CaseType="SelfValidate">
 <Text>glGetBooleanv(GL_SHADER_COMPILER, 0x0b00fbc1);</Text>
 <Text>// data = { GL_TRUE }</Text>
 <Text>// Shader compiler supported</Text>
 <Section Name="" Description="GL_INVALID_VALUE is generated if shader is not a value generated by OpenGL.">

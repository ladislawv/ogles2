  <Text>glGetError();</Text>
  <Text>// GL_INVALID_VALUE returned</Text>
</Section>
 <Section Name="" Description="GL_INVALID_OPERATION is generated if shader is not a shader object.">
  <Text>glCreateProgram();</Text>
  <Text>// 2 returned</Text>
  <Text>glShaderSource(2, 0, 0x00000000, 0x00000000);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_OPERATION returned</Text>
</Section>
 <Text>glDeleteProgram(2);</Text>
 <Text>glDeleteShader(1);</Text>

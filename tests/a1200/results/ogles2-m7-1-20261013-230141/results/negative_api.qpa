#beginTestCaseResult dEQP-GLES2.functional.negative_api.texture.copyteximage2d_incomplete_framebuffer
<?xml version="1.0" encoding="UTF-8"?>
<TestCaseResult CasePath="dEQP-GLES2.functional.negative_api.texture.copyteximage2d_incomplete_framebuffer" Version="0.3.4" CaseType="SelfValidate">
 <Section Name="" Description="GL_INVALID_FRAMEBUFFER_OPERATION is generated if the currently bound framebuffer is not framebuffer complete.">
  <Text>glGenFramebuffers(1, 0x0b00fc90);</Text>
  <Text>// framebuffers = { 2 }</Text>
  <Text>glBindFramebuffer(GL_FRAMEBUFFER, 2);</Text>
  <Text>glCheckFramebufferStatus(GL_FRAMEBUFFER);</Text>
  <Text>// GL_FRAMEBUFFER_INCOMPLETE_MISSING_ATTACHMENT returned</Text>
  <Text>glCopyTexImage2D(GL_TEXTURE_2D, 0, GL_RGB, 0, 0, 64, 64, 0);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_FRAMEBUFFER_OPERATION returned</Text>
  <Text>glCopyTexImage2D(GL_TEXTURE_CUBE_MAP_POSITIVE_X, 0, GL_RGB, 0, 0, 16, 16, 0);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_FRAMEBUFFER_OPERATION returned</Text>
  <Text>glCopyTexImage2D(GL_TEXTURE_CUBE_MAP_POSITIVE_Y, 0, GL_RGB, 0, 0, 16, 16, 0);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_FRAMEBUFFER_OPERATION returned</Text>
  <Text>glCopyTexImage2D(GL_TEXTURE_CUBE_MAP_POSITIVE_Z, 0, GL_RGB, 0, 0, 16, 16, 0);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_FRAMEBUFFER_OPERATION returned</Text>
  <Text>glCopyTexImage2D(GL_TEXTURE_CUBE_MAP_NEGATIVE_X, 0, GL_RGB, 0, 0, 16, 16, 0);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_FRAMEBUFFER_OPERATION returned</Text>
  <Text>glCopyTexImage2D(GL_TEXTURE_CUBE_MAP_NEGATIVE_Y, 0, GL_RGB, 0, 0, 16, 16, 0);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_FRAMEBUFFER_OPERATION returned</Text>
  <Text>glCopyTexImage2D(GL_TEXTURE_CUBE_MAP_NEGATIVE_Z, 0, GL_RGB, 0, 0, 16, 16, 0);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_FRAMEBUFFER_OPERATION returned</Text>
  <Text>glBindFramebuffer(GL_FRAMEBUFFER, 0);</Text>
  <Text>glDeleteFramebuffers(1, { 2 });</Text>
</Section>
 <Number Name="TestDuration" Description="Test case duration in microseconds" Tag="Time" Unit="us">8021</Number>
 <Result StatusCode="Pass">Pass</Result>
</TestCaseResult>

#endTestCaseResult


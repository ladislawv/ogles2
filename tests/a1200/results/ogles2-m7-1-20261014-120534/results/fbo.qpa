<TestCaseResult CasePath="dEQP-GLES2.functional.fbo.api.invalid_tex2d_attachments" Version="0.3.4" CaseType="SelfValidate">
 <Text>glBindFramebuffer(GL_FRAMEBUFFER, 1);</Text>
 <Text>// Attaching 2D texture using GL_TEXTURE_CUBE_MAP_NEGATIVE_X texture target</Text>
 <Text>glBindTexture(GL_TEXTURE_2D, 1);</Text>
 <Text>glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_CUBE_MAP_NEGATIVE_X, 1, 0);</Text>

  <Text>glGetError();</Text>
  <Text>// GL_NO_ERROR returned</Text>
  <Text>glGetUniformLocation(1, u_var0[1]);</Text>
  <Text>// 1 returned</Text>
  <Text>// Texture for the sampler uniform u_var0[1] will be filled with color (0.28, 0.10, 0.74, 0.49)</Text>
  <Text>glUniform1iv(1, 1, { 1 });</Text>
  <Text>glGetError();</Text>
  <Text>// GL_NO_ERROR returned</Text>
  <Text>glGetUniformLocation(1, u_var1);</Text>
  <Text>// 2 returned</Text>
  <Text>// Using type float to set boolean value (true, false, false, true) for u_var1</Text>
  <Text>glUniform4fv(2, 1, { -0.026392, 0, 0, -2.33311 });</Text>
  <Text>glGetError();</Text>
  <Text>// GL_NO_ERROR returned</Text>
</Section>
 <Section Name="GetUniforms" Description="Uniform value query">
  <Text>glGetUniformLocation(1, u_var0[0]);</Text>
  <Text>// 0 returned</Text>
  <Text>glGetUniformiv(1, 0, 0x0b007c1e);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_NO_ERROR returned</Text>
  <Text>// Got u_var0[0] value 0</Text>
  <Text>glGetUniformLocation(1, u_var0[1]);</Text>
  <Text>// 1 returned</Text>
  <Text>glGetUniformiv(1, 1, 0x0b007c1e);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_NO_ERROR returned</Text>
  <Text>// Got u_var0[1] value 1</Text>
  <Text>glGetUniformLocation(1, u_var1);</Text>
  <Text>// 2 returned</Text>
  <Text>glGetUniformfv(1, 2, 0x0b007bde);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_NO_ERROR returned</Text>
  <Text>// Got u_var1 value (true, false, false, true)</Text>
</Section>
 <Section Name="ValueCheck" Description="Verify that the reported values match the assigned values">
  <Text>// Checking uniform u_var0[0]</Text>
  <Text>// Checking uniform u_var0[1]</Text>
  <Text>// Checking uniform u_var1</Text>
</Section>
 <Section Name="RenderTest" Description="Render test">
  <Text>// Filling texture at unit 0 with color vec4(0.57, 0.58, 0.45, 0.46)</Text>
  <Text>// Filling texture at unit 1 with color vec4(0.28, 0.10, 0.74, 0.49)</Text>
  <Text>glViewport(5, 117, 32, 32);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_NO_ERROR returned</Text>
  <Text>glGetAttribLocation(1, a_position);</Text>
  <Text>// 0 returned</Text>
  <Text>glEnableVertexAttribArray(0);</Text>
  <Text>glVertexAttribPointer(0, 4, GL_FLOAT, GL_FALSE, 0, 0xa955e98);</Text>
  <Text>glDrawElements(GL_TRIANGLES, 6, GL_UNSIGNED_SHORT, 0xa955e8c);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_NO_ERROR returned</Text>
  <Text>Success: got all-white pixels (all uniforms have correct values)</Text>
</Section>
 <Number Name="TestDuration" Description="Test case duration in microseconds" Tag="Time" Unit="us">37459</Number>
 <Result StatusCode="Pass">Passed</Result>

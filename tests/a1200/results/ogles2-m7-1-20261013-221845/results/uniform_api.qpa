 <Section Name="UniformAssign" Description="Uniform value assignments">
  <Text>glGetUniformLocation(1, u_var0.m0[0]);</Text>
  <Text>// 0 returned</Text>
  <Text>glUniform2fv(0, 2, { 0, 0, 0, 0 });</Text>
  <Text>glGetError();</Text>
  <Text>// GL_NO_ERROR returned</Text>
  <Text>// Uniform u_var0.m0[1] is covered by another glUniform*v() call to the same array</Text>
  <Text>glGetUniformLocation(1, u_var0.m0[2]);</Text>
  <Text>// 2 returned</Text>
  <Text>glUniform2fv(2, 1, { 0, 0 });</Text>
  <Text>glGetError();</Text>

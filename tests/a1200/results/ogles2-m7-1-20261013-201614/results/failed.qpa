  <Text>glUniform2fv(4, 2, { 0, 0, 0, 0 });</Text>
  <Text>glGetError();</Text>
  <Text>// GL_NO_ERROR returned</Text>
  <Text>// Uniform u_var1[3] is covered by another glUniform*v() call to the same array</Text>
  <Text>glGetUniformLocation(1, u_var1[4]);</Text>
  <Text>// 6 returned</Text>
  <Text>// Using type float to set boolean value (false, false) for u_var1[4]</Text>
  <Text>glUniform2fv(6, 1, { 0, 0 });</Text>
  <Text>glGetError();</Text>
  <Text>// GL_NO_ERROR returned</Text>
  <Text>glGetUniformLocation(1, u_var2);</Text>
  <Text>// 7 returned</Text>
  <Text>// Using type float to set boolean value false for u_var2</Text>
  <Text>glUniform1f(7, 0);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_NO_ERROR returned</Text>
</Section>

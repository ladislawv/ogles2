  <Text>glUniform2fv(2, 2, { 0, 0, 0, 0 });</Text>
  <Text>glGetError();</Text>
  <Text>// GL_NO_ERROR returned</Text>
  <Text>// Uniform u_var1[1] is covered by another glUniform*v() call to the same array</Text>

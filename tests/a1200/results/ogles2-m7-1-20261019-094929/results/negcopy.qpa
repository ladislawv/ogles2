#beginTestCaseResult dEQP-GLES2.functional.negative_api.texture.copyteximage2d_invalid_target
<?xml version="1.0" encoding="UTF-8"?>
<TestCaseResult CasePath="dEQP-GLES2.functional.negative_api.texture.copyteximage2d_invalid_target" Version="0.3.4" CaseType="SelfValidate">
 <Section Name="" Description="GL_INVALID_ENUM is generated if target is invalid.">
  <Text>glCopyTexImage2D(0x0000, 0, GL_RGB, 0, 0, 40, 40, 0);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_INVALID_ENUM returned</Text>
</Section>

<?xml version="1.0" encoding="UTF-8"?>
<TestCaseResult CasePath="dEQP-GLES2.functional.state_query.texture.texture_2d_texture_wrap_s_gettexparameteri" Version="0.3.4" CaseType="SelfValidate">
 <Text>glGenTextures(1, 0x0b007fc0);</Text>
 <Text>// textures = { 1 }</Text>
 <Text>glBindTexture(GL_TEXTURE_2D, 1);</Text>
 <Text>glGetError();</Text>

 <Text>glGetTexParameteriv(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, 0x0b007e96);</Text>
 <Text>// params = { 10497 }</Text>
 <Text>glGetError();</Text>
 <Text>// GL_NO_ERROR returned</Text>
 <Text>glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);</Text>
 <Text>glGetError();</Text>
 <Text>// GL_NO_ERROR returned</Text>
 <Text>glGetTexParameteriv(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, 0x0b007e96);</Text>

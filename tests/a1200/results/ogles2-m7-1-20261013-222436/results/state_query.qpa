  <Text>glCompileShader(1);</Text>
  <Text>glGetError();</Text>
  <Text>// GL_NO_ERROR returned</Text>
  <Text>glGetShaderiv(1, GL_COMPILE_STATUS, 0x0b007eb4);</Text>
  <Text>// params = { 1 }</Text>
</Section>
 <Section Name="FragmentShader" Description="Fragment Shader">
  <Text>glCreateShader(GL_FRAGMENT_SHADER);</Text>
  <Text>// 2 returned</Text>
  <Text>glShaderSource(2, 1, 0x09199bbc, 0x00000000);</Text>

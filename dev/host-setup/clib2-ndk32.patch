diff --git a/library/include/time.h b/library/include/time.h
index 47b9481..36f5bef 100644
--- a/library/include/time.h
+++ b/library/include/time.h
@@ -107,14 +107,25 @@ extern size_t strftime(char *s, size_t maxsize, const char *format,
 /****************************************************************************/
 
 /* Timespec declaration */
+#ifdef tv_sec
+/* <sys/time.h> already maps tv_sec to tv_secs. */
 struct timespec
 {
 	time_t tv_secs;
 	long tv_nsec;
 };
-
-#ifndef tv_sec
-#define tv_sec tv_secs
+#else
+/* Both names, without a tv_sec macro: NDK 3.2's <devices/timer.h> declares
+   union { tv_sec; tv_secs; } and a macro would make that a duplicate member. */
+struct timespec
+{
+	union
+	{
+		time_t tv_sec;
+		time_t tv_secs;
+	};
+	long tv_nsec;
+};
 #endif /* tv_sec */
 
 /****************************************************************************/

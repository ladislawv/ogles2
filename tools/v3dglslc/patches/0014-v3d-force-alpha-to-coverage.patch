ogles2: v3dglslc compiles a program's alpha-to-coverage fragment variants
(its .v3da file) with v3d_force_alpha_to_coverage set: the fragment key gets
msaa and sample_alpha_to_coverage as a draw into a multisampled framebuffer
with GL_SAMPLE_ALPHA_TO_COVERAGE would give them. The offline compiler has
no multisampled framebuffer in its GLES2 context. ogles2.library uses these
variants in a 4x MSAA context (dEQP-GLES2 multisample.proportionality_
alpha_to_coverage). Off, nothing changes.

diff --git a/src/gallium/drivers/v3d/v3d_program.c b/src/gallium/drivers/v3d/v3d_program.c
--- a/src/gallium/drivers/v3d/v3d_program.c
+++ b/src/gallium/drivers/v3d/v3d_program.c
@@ -628,6 +628,10 @@
                v3d_polygon_mode(v3d, prim_mode) == PIPE_POLYGON_MODE_LINE;
 }
 
+/* ogles2 (v3dglslc): set while it draws a program's alpha-to-coverage
+ * variants. */
+bool v3d_force_alpha_to_coverage;
+
 static void
 v3d_update_compiled_fs(struct v3d_context *v3d, enum mesa_prim prim_mode)
 {
@@ -661,7 +665,14 @@
         } else {
                 key->logicop_func = PIPE_LOGICOP_COPY;
         }
-        if (job->msaa) {
+        if (v3d_force_alpha_to_coverage) {
+                /* ogles2's v3dglslc: a program's alpha-to-coverage variants
+                 * (its .v3da), for a 4x MSAA context drawing with
+                 * GL_SAMPLE_ALPHA_TO_COVERAGE; the compiler has no
+                 * multisampled framebuffer to draw into. */
+                key->msaa = true;
+                key->sample_alpha_to_coverage = true;
+        } else if (job->msaa) {
                 key->msaa = v3d->rasterizer->base.multisample;
                 key->sample_alpha_to_coverage = v3d->blend->base.alpha_to_coverage;
                 key->sample_alpha_to_one = v3d->blend->base.alpha_to_one;

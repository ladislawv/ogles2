ogles2: ARB_texture_rectangle in GLES2 contexts (AmigaOS 4's ogles2 offers it):
GLSL ES shaders take "#extension GL_ARB_texture_rectangle", sampler2DRect and
texture2DRect, and v3dglslc's key-state draws can bind rectangle textures. No
effect on desktop GL (the same API check, through the extension table).
In GLSL ES sampler2DRect has sampler2D's default precision (lowp), as a
shader written for AmigaOS 4's compiler expects.

diff --git a/src/compiler/glsl/glsl_parser.yy b/src/compiler/glsl/glsl_parser.yy
index 6051376558e..490b5f951a4 100644
--- a/src/compiler/glsl/glsl_parser.yy
+++ b/src/compiler/glsl/glsl_parser.yy
@@ -315,6 +315,8 @@ translation_unit:
          state->symbols->add_default_precision_qualifier("samplerExternalOES", ast_precision_low);
          state->symbols->add_default_precision_qualifier("__samplerExternal2DY2YEXT", ast_precision_low);
          state->symbols->add_default_precision_qualifier("samplerCube", ast_precision_low);
+         /* ARB_texture_rectangle in GLSL ES (ogles2): sampler2DRect as sampler2D (its name in this table: get_type_name_for_precision_qualifier) */
+         state->symbols->add_default_precision_qualifier("samplerRect", ast_precision_low);
          state->symbols->add_default_precision_qualifier("atomic_uint", ast_precision_high);
       }
       _mesa_glsl_initialize_types(state);

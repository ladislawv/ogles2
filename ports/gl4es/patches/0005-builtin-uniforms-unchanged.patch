diff --git a/src/gl/matrix.c b/src/gl/matrix.c
index e9990d61..73c11ec5 100644
--- a/src/gl/matrix.c
+++ b/src/gl/matrix.c
@@ -24,6 +24,28 @@ void alloc_matrix(matrixstack_t **matrixstack, int depth) {
 
 #define TOP(A) (glstate->A->stack+(glstate->A->top*16))
 
+/* ogles2 (ports/gl4es): bumped whenever a matrix's value changes; not by a
+ * glLoadIdentity of an identity matrix or a glLoadMatrixf of the same
+ * values (Quake III resets its texture matrices around every stage).
+ * realize_glenv (fpe.c) skips a program's built-in matrix uniforms while
+ * it is the generation they were last sent at. */
+unsigned int gl4es_ogles2_matgen = 1;
+
+static int ogles2_current_identity(void) {
+	switch(glstate->matrix_mode) {
+		case GL_MODELVIEW:
+			return glstate->modelview_matrix->identity;
+		case GL_PROJECTION:
+			return glstate->projection_matrix->identity;
+		case GL_TEXTURE:
+			return glstate->texture_matrix[glstate->texture.active]->identity;
+		default:
+			if(glstate->matrix_mode>=GL_MATRIX0_ARB && glstate->matrix_mode<GL_MATRIX0_ARB+MAX_ARB_MATRIX)
+				return glstate->arb_matrix[glstate->matrix_mode-GL_MATRIX0_ARB]->identity;
+			return 0;
+	}
+}
+
 static GLfloat* update_current_mat() {
 	switch(glstate->matrix_mode) {
 		case GL_MODELVIEW:
@@ -184,7 +206,7 @@ DBG(printf("glPopMatrix(), list=%p\n", glstate->list.active);)
 	noerrorShim();
 	switch(matrix_mode) {
 		#define P(A) if(glstate->A->top) { \
-			--glstate->A->top; \
+			--glstate->A->top; ++gl4es_ogles2_matgen; \
 			glstate->A->identity = is_identity(update_current_mat()); \
 			if (send_to_hardware()) {LOAD_GLES(glLoadMatrixf); gles_glLoadMatrixf(update_current_mat()); } \
 		} else errorShim(GL_STACK_UNDERFLOW)
@@ -227,6 +249,8 @@ DBG(printf("glLoadMatrix(%f, %f, %f, %f, %f, %f, %f...), list=%p\n", m[0], m[1],
 			return;
 		}
 	}
+	if(memcmp(update_current_mat(), m, 16*sizeof(GLfloat)))
+		++gl4es_ogles2_matgen;
 	memcpy(update_current_mat(), m, 16*sizeof(GLfloat));
 	const int id = update_current_identity(0);
 	if(glstate->matrix_mode==GL_MODELVIEW)
@@ -261,6 +285,7 @@ DBG(printf("glMultMatrix(%f, %f, %f, %f, %f, %f, %f...), list=%p\n", m[0], m[1],
 	}
 	GLfloat *current_mat = update_current_mat();
 	matrix_mul(current_mat, m, current_mat);
+	++gl4es_ogles2_matgen;
 	const int id = update_current_identity(0);
 	if(glstate->matrix_mode==GL_MODELVIEW)
 		glstate->normal_matrix_dirty = glstate->inv_mv_matrix_dirty = 1;
@@ -288,6 +313,8 @@ DBG(printf("glLoadIdentity(), list=%p\n", glstate->list.active);)
 			return;
 		}
 	}
+	if(!ogles2_current_identity())
+		++gl4es_ogles2_matgen;
 	set_identity(update_current_mat());
 	update_current_identity(1);
 	if(glstate->matrix_mode==GL_MODELVIEW)

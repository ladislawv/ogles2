ogles2 (ports/sdl3): OpenGL ES 2.0 on ogles2.library for SDL3_68k.

- The configuration enables SDL_VIDEO_OPENGL_ES2 and SDL's GLES2 renderer
  (not in the software-only variant).
- The video device's GL_LoadLibrary chooses the backend by the profile
  asked for (as AmigaOS 4's driver): ES 2.x gets ogles2.library
  (SDL_os3opengles2.c, from ports/sdl3), anything else minigl.library.
- The window data notes an ogles2 context (gl_es); MiniGL's resize and
  destroy, which the window and event code call directly, hand those over.
- Makefile.amigaos3 builds the GLES2 renderer, takes $(OGLES2_CFLAGS) for
  ogles2's and MiniGL's headers, and compiles clib2 objects with
  -fshort-wchar (clib2's wchar_t is 2 bytes; SDL_string.c asserts the
  compiler agrees).

diff --git a/SDL3/Makefile.amigaos3 b/SDL3/Makefile.amigaos3
index 8a3f476..e07e6e6 100644
--- a/SDL3/Makefile.amigaos3
+++ b/SDL3/Makefile.amigaos3
@@ -2,9 +2,11 @@ CC=m68k-amigaos-gcc
 AR=m68k-amigaos-ar
 RANLIB=m68k-amigaos-ranlib
 COMMON=-std=gnu99 -O2 -mcpu=68040 -mhard-float -Wall -Wextra -Wno-unused-parameter -I./include -I./include/build_config -I./include/SDL3 -I./src -D__AMIGAOS3__
-CLIB2=$(COMMON) -mcrt=clib2 -DNOIXEMUL
+# ogles2 (ports/sdl3): clib2's wchar_t is unsigned short (SDL_string.c checks
+# it against the compiler's); ogles2's and MiniGL's headers.
+CLIB2=$(COMMON) -mcrt=clib2 -DNOIXEMUL -fshort-wchar $(OGLES2_CFLAGS)
 LIBNIX=$(COMMON) -noixemul -DNOIXEMUL
-SOURCES=$(wildcard ./src/*.c ./src/atomic/*.c ./src/audio/*.c ./src/audio/amigaos3/*.c ./src/camera/*.c ./src/camera/dummy/*.c ./src/cpuinfo/*.c ./src/dialog/*.c ./src/dialog/amigaos3/*.c ./src/events/*.c ./src/gpu/SDL_gpu.c ./src/haptic/*.c ./src/io/*.c ./src/io/generic/SDL_asyncio_generic.c ./src/joystick/*.c ./src/joystick/amigaos3/*.c ./src/libm/*.c ./src/loadso/dummy/*.c ./src/locale/*.c ./src/locale/amigaos3/*.c ./src/main/generic/*.c ./src/main/SDL_main_callbacks.c ./src/main/SDL_runapp.c ./src/misc/*.c ./src/power/*.c ./src/process/*.c ./src/process/dummy/*.c ./src/render/*.c ./src/render/software/*.c ./src/sensor/*.c ./src/sensor/dummy/*.c ./src/stdlib/*.c ./src/storage/SDL_storage.c ./src/storage/generic/SDL_genericstorage.c ./src/thread/*.c ./src/thread/amigaos3/*.c ./src/thread/generic/SDL_syscond.c ./src/thread/generic/SDL_sysrwlock.c ./src/time/SDL_time.c ./src/time/amigaos3/SDL_systime.c ./src/timer/*.c ./src/timer/amigaos3/*.c ./src/tray/SDL_tray_utils.c ./src/tray/dummy/*.c ./src/video/*.c ./src/video/yuv2rgb/yuv_rgb_std.c ./src/video/amigaos3/*.c ./src/video/dummy/*.c ./src/filesystem/SDL_filesystem.c ./src/filesystem/amigaos3/*.c)
+SOURCES=$(wildcard ./src/*.c ./src/atomic/*.c ./src/audio/*.c ./src/audio/amigaos3/*.c ./src/camera/*.c ./src/camera/dummy/*.c ./src/cpuinfo/*.c ./src/dialog/*.c ./src/dialog/amigaos3/*.c ./src/events/*.c ./src/gpu/SDL_gpu.c ./src/haptic/*.c ./src/io/*.c ./src/io/generic/SDL_asyncio_generic.c ./src/joystick/*.c ./src/joystick/amigaos3/*.c ./src/libm/*.c ./src/loadso/dummy/*.c ./src/locale/*.c ./src/locale/amigaos3/*.c ./src/main/generic/*.c ./src/main/SDL_main_callbacks.c ./src/main/SDL_runapp.c ./src/misc/*.c ./src/power/*.c ./src/process/*.c ./src/process/dummy/*.c ./src/render/*.c ./src/render/software/*.c ./src/render/opengles2/*.c ./src/sensor/*.c ./src/sensor/dummy/*.c ./src/stdlib/*.c ./src/storage/SDL_storage.c ./src/storage/generic/SDL_genericstorage.c ./src/thread/*.c ./src/thread/amigaos3/*.c ./src/thread/generic/SDL_syscond.c ./src/thread/generic/SDL_sysrwlock.c ./src/time/SDL_time.c ./src/time/amigaos3/SDL_systime.c ./src/timer/*.c ./src/timer/amigaos3/*.c ./src/tray/SDL_tray_utils.c ./src/tray/dummy/*.c ./src/video/*.c ./src/video/yuv2rgb/yuv_rgb_std.c ./src/video/amigaos3/*.c ./src/video/dummy/*.c ./src/filesystem/SDL_filesystem.c ./src/filesystem/amigaos3/*.c)
 REL=$(patsubst ./%,%,$(SOURCES:.c=.o))
 CLOBJ=$(addprefix build/clib2/,$(REL))

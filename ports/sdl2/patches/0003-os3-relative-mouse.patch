+/*
+ * Relative mouse mode (ogles2 ports/sdl2 patch 0003). Without it SDL emulates
+ * relative mode by warping the pointer back to the window's centre, and
+ * OS3_WarpMouse cannot warp: the hidden pointer ran into the screen's edge and
+ * a game's mouse look stopped there. Here the mode is only recorded; the event
+ * pump (SDL_os3events.c) sets IDCMP_DELTAMOVE on the windows to match, so that
+ * Intuition reports the mouse's own movement, which goes on at the edge.
+ */
+SDL_bool OS3_relative_mouse = SDL_FALSE;
+
+static int OS3_SetRelativeMouseMode(SDL_bool enabled)
+{
+    OS3_relative_mouse = enabled;
+    return 0;
+}

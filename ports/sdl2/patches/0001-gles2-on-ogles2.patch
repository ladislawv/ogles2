diff --git a/libSDL2-amigaos3-main/include/SDL_config_amigaos3.h b/libSDL2-amigaos3-main/include/SDL_config_amigaos3.h
index 864ee533..87d41a7e 100644
--- a/libSDL2-amigaos3-main/include/SDL_config_amigaos3.h
+++ b/libSDL2-amigaos3-main/include/SDL_config_amigaos3.h
@@ -180,6 +180,10 @@
 #if !defined(WARPUP)
 #if !defined(SDL_AMIGAOS3_SW_ONLY)
 #define SDL_VIDEO_OPENGL            1   /* minigl.library backend (68k) */
+/* ogles2 (ports/sdl2): OpenGL ES 2.0 through ogles2.library for windows whose
+ * GL profile is ES 2.x, and SDL's GLES2 renderer on it (SDL_os3opengles2.c). */
+#define SDL_VIDEO_OPENGL_ES2        1
+#define SDL_VIDEO_RENDER_OGL_ES2    1
 #endif
 #endif

@@ -166,6 +169,13 @@ void OS3_GL_ResizeWindow(_THIS, SDL_Window *window, int w, int h)
     OS3_WindowData *data = window ? (OS3_WindowData *)window->driverdata : NULL;
     (void)_this;
 
+#if defined(SDL_VIDEO_OPENGL_ES2)
+    if (OS3_GLES2_OwnsWindow(window)) {
+        OS3_GLES2_ResizeWindow(_this, window, w, h);

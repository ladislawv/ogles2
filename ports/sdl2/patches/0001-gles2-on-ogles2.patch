+            ULONG friend_depth = GetCyberMapAttr(friend_bm, CYBRMATTR_DEPTH);
+            struct BitMap *scale_bm = AllocBitMap(w, h, friend_depth, BMF_MINPLANES, friend_bm);
 
             if (scale_bm) {
                 struct RastPort *scale_rp;
diff --git a/libSDL2-amigaos3-main/src/video/amigaos3/SDL_os3opengl.c b/libSDL2-amigaos3-main/src/video/amigaos3/SDL_os3opengl.c

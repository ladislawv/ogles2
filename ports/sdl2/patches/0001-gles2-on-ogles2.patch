ogles2 (ports/sdl2): OpenGL ES 2.0 on ogles2.library for SDL2_68k.

- The configuration enables SDL_VIDEO_OPENGL_ES2 and SDL's GLES2 renderer.
- The video device's GL_LoadLibrary chooses the backend by the profile
  asked for (as AmigaOS 4's driver): ES 2.x gets ogles2.library
  (SDL_os3opengles2.c, from ports/sdl2), anything else minigl.library.
- The window data notes an ogles2 context (gl_es); MiniGL's resize and
  delete, which the window and event code call directly, hand those over.
- The window surface stays the driver's framebuffer by default (as on
  Windows): with the GLES2 renderer present SDL would otherwise emulate it
  with a GLES2 texture, inside the software renderer's creation (a crash).
- SDL_os3framebuffer.c: GetCyberMapAttr moved out of AllocBitMap's
  arguments (with GCC 6.5's inline headers A6 is loaded first, so
  AllocBitMap was called through CyberGfxBase: the software renderer
  crashed when a window is larger than its surface).
- Both Makefiles build the new backend and the GLES2 renderer, with
  $(OGLES2_CFLAGS) for ogles2's headers.

diff --git a/libSDL2-amigaos3-main/Makefile b/libSDL2-amigaos3-main/Makefile
index d7ef54e1..349adfbf 100644
--- a/libSDL2-amigaos3-main/Makefile
+++ b/libSDL2-amigaos3-main/Makefile
@@ -19,6 +19,8 @@ CFLAGS = -std=gnu99 -O2 -m68040 -mcrt=clib2 -mhard-float \
          -Wall -Wextra -Wno-unused-parameter -Wno-sign-compare \
          -I./include -I./src \
          -D__AMIGAOS3__ -DSDL_OS3_DEBUG
+# ogles2 (ports/sdl2): its headers (include/ and the generated proto/ogles2.h)
+CFLAGS += $(OGLES2_CFLAGS)
 
 # --- SDL2 Core Source Files (platform-independent) ---
 # Enumerated from SDL2 CMakeLists.txt (SDL2 branch, commit f9e8203)
@@ -123,6 +125,7 @@ SRCS_VIDEO_CORE = \
 SRCS_VIDEO_OS3 = \
 	src/video/amigaos3/SDL_os3video.c \
 	src/video/amigaos3/SDL_os3opengl.c \
+	src/video/amigaos3/SDL_os3opengles2.c \
 	src/video/amigaos3/SDL_os3window.c \
 	src/video/amigaos3/SDL_os3framebuffer.c \
 	src/video/amigaos3/SDL_os3events.c \
@@ -215,7 +218,12 @@ SRCS_RENDER_SW = \
 	src/render/software/SDL_rotate.c \
 	src/render/software/SDL_triangle.c
 
-SRCS_RENDER = $(SRCS_RENDER_CORE) $(SRCS_RENDER_SW)
+# ogles2 (ports/sdl2): SDL's GLES2 renderer on ogles2.library
+SRCS_RENDER_GLES2 = \
+	src/render/opengles2/SDL_render_gles2.c \
+	src/render/opengles2/SDL_shaders_gles2.c
+
+SRCS_RENDER = $(SRCS_RENDER_CORE) $(SRCS_RENDER_SW) $(SRCS_RENDER_GLES2)
 
 # --- Filesystem: AmigaOS3 (PROGDIR: / ENVARC:) ---
 SRCS_FILESYS = \

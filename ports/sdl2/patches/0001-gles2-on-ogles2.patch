diff --git a/libSDL2-amigaos3-main/src/video/SDL_video.c b/libSDL2-amigaos3-main/src/video/SDL_video.c
index 228ba6ad..cb6ad2a0 100644
--- a/libSDL2-amigaos3-main/src/video/SDL_video.c
+++ b/libSDL2-amigaos3-main/src/video/SDL_video.c
@@ -2717,6 +2717,14 @@ static SDL_bool ShouldAttemptTextureFramebuffer(void)
 #endif
 #if defined(__EMSCRIPTEN__)
         attempt_texture_framebuffer = SDL_FALSE;
+#endif
+#if defined(__AMIGAOS3__)
+        /* ogles2 (ports/sdl2): the driver writes the window surface straight
+           into the RTG bitmap; a GLES2 texture framebuffer would make a GLES2
+           renderer in the middle of the software renderer's creation. */
+        if (_this->CreateWindowFramebuffer) {
+            attempt_texture_framebuffer = SDL_FALSE;
+        }
 #endif
     }
     return attempt_texture_framebuffer;
diff --git a/libSDL2-amigaos3-main/src/video/amigaos3/SDL_os3framebuffer.c b/libSDL2-amigaos3-main/src/video/amigaos3/SDL_os3framebuffer.c

+    }
+#endif
+
     if (!data || !data->gl_context || w <= 0 || h <= 0) {
         return;
     }
@@ -233,6 +243,12 @@ void OS3_GL_DeleteContext(_THIS, SDL_GLContext context)
     if (!context) {
         return;
     }
+#if defined(SDL_VIDEO_OPENGL_ES2)
+    if (OS3_GLES2_OwnsContext(_this, context)) {
+        OS3_GLES2_DeleteContext(_this, context);
+        return;
+    }
+#endif
 
     previous = *MiniGLDispatch->currentContext;
     /* Delete only the context; the native window remains valid. */

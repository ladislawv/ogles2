diff --git a/libSDL2-amigaos3-main/src/atomic/SDL_atomic.c b/libSDL2-amigaos3-main/src/atomic/SDL_atomic.c
index 79a006d5..11023ca0 100644
--- a/libSDL2-amigaos3-main/src/atomic/SDL_atomic.c
+++ b/libSDL2-amigaos3-main/src/atomic/SDL_atomic.c
@@ -109,7 +109,28 @@ extern __inline int _SDL_xadd_watcom(volatile int *a, int v);
 #define EMULATE_CAS
 #endif
 
-#ifdef EMULATE_CAS
+#if defined(EMULATE_CAS) && defined(__AMIGAOS3__)
+/* AmigaOS 3: the read-modify-write under Forbid(), which on its one CPU is
+   atomic against every other task; no spinlock, so nothing ever waits. With
+   the spinlocks below, a task of higher priority (the audio thread, 10) that
+   wanted the lock a lower one held (the application's task, 0, in an
+   SDL_AtomicAdd) spun for ever: the holder never ran again to release it,
+   and everything under priority 10 stopped (an application froze the whole
+   A1200 at random, seconds to minutes in). */
+#include <proto/exec.h>
+
+static SDL_INLINE void enterLock(void *a)
+{
+    (void)a;
+    Forbid();
+}
+
+static SDL_INLINE void leaveLock(void *a)
+{
+    (void)a;
+    Permit();
+}
+#elif defined(EMULATE_CAS)
 static SDL_SpinLock locks[32];
 
 static SDL_INLINE void enterLock(void *a)
diff --git a/libSDL2-amigaos3-main/src/atomic/SDL_spinlock.c b/libSDL2-amigaos3-main/src/atomic/SDL_spinlock.c
index f68560fe..d54b4a9d 100644
--- a/libSDL2-amigaos3-main/src/atomic/SDL_spinlock.c
+++ b/libSDL2-amigaos3-main/src/atomic/SDL_spinlock.c
@@ -204,8 +204,16 @@ void SDL_AtomicLock(SDL_SpinLock *lock)
             iterations++;
             SDL_CPUPauseInstruction();
         } else {
+#ifdef __AMIGAOS3__
+            /* A real sleep. exec always runs the highest-priority task
+               that is ready, so a "yield" (Delay(0)) gives nothing to a
+               holder of lower priority, which then never runs to release
+               the lock. One tick (20 ms) lets it. */
+            SDL_Delay(1);
+#else
             /* !!! FIXME: this doesn't definitely give up the current timeslice, it does different things on various platforms. */
             SDL_Delay(0);
+#endif
         }
     }
 }

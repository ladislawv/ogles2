 #define OS3AHI_DRIVER_NAME "ahi"
 
+/* AHI replies signal the port's task. The port comes from CreateMsgPort in
+   OpenDevice, which SDL runs in the task that opens the device, but the I/O
+   (WaitIO in PlayDevice and WaitDevice) runs in SDL's audio thread: it waited
+   for a signal that went to the other task, and the thread hung after two
+   buffers (silence, then noise; arczi84, github.com/ladislawv/ogles2 issue 5).
+   The thread takes the port over when it starts, before any request is sent,
+   and gives it back when it ends: a request still in flight then signals the
+   opening task, in which CloseDevice aborts and waits for it (a reply to the
+   ended thread's task would write into freed memory). Under Disable: a device
+   may reply from an interrupt. */
+static void OS3AHI_ThreadInit(_THIS)
+{
+    struct SDL_PrivateAudioData *hidden = _this->hidden;
+    BYTE bit;
+
+    if (!hidden || !hidden->port || (bit = AllocSignal(-1)) < 0)
+        return;
+    Disable();
+    hidden->port->mp_SigBit  = (UBYTE)bit;
+    hidden->port->mp_SigTask = FindTask(NULL);
+    Enable();
+    hidden->thread_sigbit = bit;
+}
+
+static void os3ahi_return_port(struct SDL_PrivateAudioData *hidden)
+{
+    Disable();
+    hidden->port->mp_SigBit  = (UBYTE)hidden->open_sigbit;
+    hidden->port->mp_SigTask = hidden->open_task;
+    Enable();
+}
+
+static void OS3AHI_ThreadDeinit(_THIS)
+{
+    struct SDL_PrivateAudioData *hidden = _this->hidden;
+
+    if (!hidden || !hidden->port || hidden->thread_sigbit < 0)
+        return;
+    os3ahi_return_port(hidden);
+    FreeSignal(hidden->thread_sigbit);
+    hidden->thread_sigbit = -1;
+}
+
 static void OS3AHI_DetectDevices(void)
 {
 }

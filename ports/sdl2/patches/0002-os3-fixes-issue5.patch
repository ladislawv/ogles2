     hidden->port = CreateMsgPort();
     if (!hidden->port)
         return SDL_SetError("AHI: CreateMsgPort failed");
+    hidden->open_task     = hidden->port->mp_SigTask;
+    hidden->open_sigbit   = (BYTE)hidden->port->mp_SigBit;
+    hidden->thread_sigbit = -1;
 
     /* Create primary AHIRequest */

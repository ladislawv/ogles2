+/* A display screen whose CloseScreen had to wait for its window: os3_pending_screen */
+
+static BOOL os3_try_close_screen(struct Screen *screen)
+{
+    if (screen->FirstWindow)
+        return FALSE;
+    if (screen->UserData) {
+        FreeMem(screen->UserData, 6 * sizeof(UWORD)); /* the empty pointer */
+        screen->UserData = NULL;
+    }
+    return CloseScreen(screen) ? TRUE : FALSE;
+}
+
+void OS3_ReleaseDisplayScreen(struct Screen *screen)
+{
+    if (screen && screen == os3_pending_screen && os3_try_close_screen(screen))
+        os3_pending_screen = NULL;
+}
+
+/* Leaving fullscreen: the screen goes now, or when its window has closed.
+ * (It used to be dropped even when CloseScreen failed with the game's window
+ * still on it, and restoring the desktop mode opened another screen: two
+ * blank screens stayed after a fullscreen program quit.) */
+static void os3_close_display_screen(OS3_DisplayData *data)
+{
+    if (!data || !data->fullscreen_screen)
+        return;
+    if (!os3_try_close_screen(data->fullscreen_screen)) {
+        if (os3_pending_screen)
+            os3_try_close_screen(os3_pending_screen);
+        os3_pending_screen = data->fullscreen_screen;
+    }
+    data->fullscreen_screen = NULL;
+}

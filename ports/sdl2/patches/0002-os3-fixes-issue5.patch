     return best_id;
 }
 
+/*
+ * A 32-bit RTG mode of the requested size. On PiStorm RTG,
+ * BestCModeIDTags(CYBRBIDTG_Depth, 32) finds nothing, and the old fallback
+ * (640x480x16) then failed to open as 32 bit: no fullscreen. The same was
+ * fixed in the MiniGL port's SDL 1.2 (CGX_FindBGRA32Mode). Exact size first,
+ * BGRA32 preferred (the PiStorm RTG / V3D format), else the smallest larger
+ * 32-bit mode.
+ */
+ULONG OS3_Find32BitMode(int want_w, int want_h)
+{
+    ULONG id = INVALID_ID;
+    ULONG exact_any = INVALID_ID, best = INVALID_ID;
+    ULONG best_w = 0xFFFFFFFF, best_h = 0xFFFFFFFF;
+
+    if (!CyberGfxBase)
+        return INVALID_ID;
+    while ((id = NextDisplayInfo(id)) != INVALID_ID) {
+        ULONG w, h;
+        if (!IsCyberModeID(id))
+            continue;
+        if (GetCyberIDAttr(CYBRIDATTR_BPPIX, id) != 4)
+            continue;
+        w = GetCyberIDAttr(CYBRIDATTR_WIDTH, id);
+        h = GetCyberIDAttr(CYBRIDATTR_HEIGHT, id);
+        if ((int)w == want_w && (int)h == want_h) {
+            if (GetCyberIDAttr(CYBRIDATTR_PIXFMT, id) == PIXFMT_BGRA32)
+                return id;
+            if (exact_any == INVALID_ID)
+                exact_any = id;
+        } else if ((int)w >= want_w && (int)h >= want_h &&
+                   (w < best_w || (w == best_w && h < best_h))) {
+            best_w = w;
+            best_h = h;
+            best = id;
+        }
+    }
+    return exact_any != INVALID_ID ? exact_any : best;
+}
+
+/* BestCModeIDTags for 32 bit, but only if it really is a 32-bit mode */
+ULONG OS3_Best32BitMode(int want_w, int want_h)
+{
+    ULONG modeid = OS3_Find32BitMode(want_w, want_h);
+    if (modeid != INVALID_ID)
+        return modeid;
+    if (!CyberGfxBase)
+        return INVALID_ID;
+    modeid = BestCModeIDTags(
+        CYBRBIDTG_NominalWidth,  want_w,
+        CYBRBIDTG_NominalHeight, want_h,
+        CYBRBIDTG_Depth,         32,
+        TAG_DONE
+    );
+    if (modeid != INVALID_ID && GetCyberIDAttr(CYBRIDATTR_BPPIX, modeid) != 4)
+        modeid = INVALID_ID;
+    return modeid;
+}

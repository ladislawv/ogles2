 std::istream *
 Util::get_resource(const std::filesystem::path &path)
 {
+#if GLMARK2_USE_AMIGA
+    /* AmigaOS 3 (libnix): the whole file through stdio into memory. The
+     * loaders seek about (3ds chunks), which libstdc++'s file streams did
+     * not do reliably there, and one read is faster. A missing file gives a
+     * failed stream, as an ifstream would. */
+    std::istringstream *iss = new std::istringstream(std::ios::binary);
+    FILE *f = fopen(path.string().c_str(), "rb");
+    if (!f) {
+        iss->setstate(std::ios::failbit);
+        return iss;
+    }
+    std::string data;
+    char buf[16384];
+    size_t n;
+    while ((n = fread(buf, 1, sizeof(buf), f)) > 0)
+        data.append(buf, n);
+    fclose(f);
+    iss->str(data);
+    return iss;
+#else
     std::ifstream *ifs = new std::ifstream(path, std::ios::binary);
 
     return static_cast<std::istream *>(ifs);
+#endif
 }
 
